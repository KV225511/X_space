# ==============================================================================
# AstroFoundation — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your API keys:
# cp .env.example .env

# ------------------------------------------------------------------------------
# LLM Providers (for Phase 9 Scientific Report Generation)
# ------------------------------------------------------------------------------
# Provider options: "deepseek" (recommended), "gemini", or "openai"
LLM_PROVIDER=deepseek

# DeepSeek API Key (Get key from https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini API Key (Alternative option from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# OpenAI API Key (Alternative option, used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Astronomical Databases & Tools (Phase 8 Agent)
# ------------------------------------------------------------------------------
# NASA Astrophysics Data System (ADS) API Token
# (Get free token from https://ui.adsabs.harvard.edu/user/settings/token)
ADS_DEV_KEY=your_nasa_ads_token_here
ADS_API_KEY=

# Offline Mode (Set to 1 for offline testing/CI without external network calls)
ASTRO_OFFLINE_MODE=0

# ------------------------------------------------------------------------------
# Hardware & Training Infrastructure
# ------------------------------------------------------------------------------
# Device selection: "auto", "cuda", or "cpu"
DEVICE=auto

# Weights & Biases Logging (Optional, for training runs)
WANDB_API_KEY=
WANDB_PROJECT=astrofoundation

# ------------------------------------------------------------------------------
# FastAPI Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
